{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "v3 gate definition entry",
  "required": ["id", "name", "name_v2", "operation", "limit", "unit", "mandatory", "stage_v2", "stage_v3", "applicability", "reason"],
  "properties": {
    "id": { "type": "string", "pattern": "^G[0-9]{2}[ab]?$" },
    "name": { "type": "string", "minLength": 1 },
    "name_v2": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["boolean", "max", "min"] },
    "limit": { "type": "number" },
    "unit": { "const": "dimensionless" },
    "mandatory": { "type": "boolean" },
    "stage_v2": { "type": "string", "pattern": "^S[0-9]{2}$" },
    "stage_v3": { "type": ["string", "null"], "pattern": "^S[0-9]{2}$" },
    "applicability": { "enum": ["applicable", "deferred", "not_applicable", "conditional"] },
    "reason": { "type": "string", "minLength": 1 }
  },
  "description": "The 28 v2 gate ids, operations, limits and stage_v2 are preserved verbatim; v3 adds classification with a reason. stage_v3 null means the stage has no active gate placement in v3. Measurement results remain separate under gate_result.schema.json."
}
